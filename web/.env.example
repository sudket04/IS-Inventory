# Copy to .env and fill in, or set these as real environment variables /
# Windows service environment on the server. See README.md section 2.

MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=ITInventory

# SQL Authentication (leave MSSQL_TRUSTED unset)
MSSQL_USER=inventory_app
MSSQL_PASSWORD=ChangeMe#2026

# Windows Authentication instead of SQL auth: set MSSQL_TRUSTED=1 and fill
# MSSQL_DOMAIN / MSSQL_USER / MSSQL_PASSWORD with the service account.
# MSSQL_TRUSTED=1
# MSSQL_DOMAIN=CORP

# false when SQL Server doesn't support TLS; false when not using a trusted cert
MSSQL_ENCRYPT=true
MSSQL_TRUST_CERT=true

PORT=8000
# Set to 1 when running behind an HTTPS reverse proxy (IIS ARR / nginx)
INVENTORY_HTTPS=
